# Python
__pycache__/
*.py[cod]
.venv/

# Local app state — personal (NAS paths, creator/download history)
app_state.json
app_state.backups/
*.corrupt
*.corrupt-*
*.tmp
*.bak
*.tsv

# Per-run pawchive diagnostics (regenerated every run)
pawchive_diag.jsonl

# Cached creator profile images
.avatars/

# Cached media thumbnails (local fallback; usually on the NAS archive dir)
.thumbs/

# Duplicates panel: reversible apply journals (undo lives here until re-scan)
.dedupe/

# Albums tab: per-destination engine state (cyberdrop-dl db/config/logs, gallery-dl
# archive, the shared failures db) — bookkeeping, regenerated as needed
.album_state/

# Exported browser cookies (pawchive Cloudflare clearance, etc.) — personal/secret
*_cookies.txt
.pawchive_cookies.txt

# Stray downloaded media from early album-downloader testing (not source)
gallery-dl/

# Claude Code local settings
.claude/
